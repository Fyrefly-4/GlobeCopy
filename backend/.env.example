# Copy to backend/.env. Never commit a real API key.
PORT=3001
LLM_API_KEY=
# Chat Completions-compatible base URL (do not include /chat/completions).
# DeepSeek defaults below; change these values to use another compatible service.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=60000
